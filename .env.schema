# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Selects the deployment secrets file.
# @public @type=enum(production) @required
APP_ENV=

# Cloudflare account hosting Alchemy's encrypted deployment state.
# @required @public
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare token used to provision and access the state store.
# @required @sensitive
CLOUDFLARE_API_TOKEN=

# Railway account token. Project-scoped tokens cannot create projects.
# @required @sensitive
RAILWAY_API_TOKEN=

# Optional hostname, without a scheme or path. Configure its DNS separately.
# @public
DOCS_DOMAIN=

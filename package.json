    "docs:deploy": "APP_ENV=production bun --bun varlock run -- alchemy deploy alchemy/alchemy.run.ts --stage prod --profile better-auth-rs",
    "docs:destroy": "APP_ENV=production bun --bun varlock run -- alchemy destroy alchemy/alchemy.run.ts --stage prod --profile better-auth-rs",
    "docs:secrets:edit": "sops secrets.production.sops.json"
  },

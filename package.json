  "scripts": {
    "test": "devenv shell -- ./scripts/check.sh",
    "docs:dev": "bun --cwd docs dev",
    "docs:build": "bun --cwd docs build",
    "docs:check": "bun --cwd docs check",
    "docs:preview": "bun --cwd docs preview",
    "docs:infra:check": "tsc --project alchemy/tsconfig.json",

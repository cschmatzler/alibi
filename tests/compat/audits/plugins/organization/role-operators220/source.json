{
  "literal": " { \"team\" : [\"create\", \"create\"], \"member\":[\"update\"], \"empty\": [], \"Custom\": [\"publish\"] } ",
  "cases": [
    {
      "name": "plain-and-success",
      "request": {
        "team": [
          "create"
        ],
        "member": [
          "update"
        ]
      },
      "connector": "AND",
      "expected": {
        "success": true
      }
    },
    {
      "name": "resource-and-denial",
      "request": {
        "team": [
          "create"
        ],
        "member": [
          "delete"
        ]
      },
      "connector": "AND",
      "expected": {
        "success": false,
        "error": "unauthorized to access resource \"member\""
      }
    },
    {
      "name": "resource-or-success",
      "request": {
        "team": [
          "create"
        ],
        "member": [
          "delete"
        ]
      },
      "connector": "OR",
      "expected": {
        "success": true
      }
    },
    {
      "name": "action-and-denial",
      "request": {
        "team": [
          "delete",
          "create"
        ]

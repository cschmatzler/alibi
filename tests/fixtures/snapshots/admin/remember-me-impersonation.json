        "content-type": [
          "application/json"
        ]
      },
      "body": {
        "message": "Failed to find admin session"
      }
    }
  },
  {
    "forged admin cookie": {
      "status": 500,
      "headers": {
        "content-type": [
          "application/json"
        ]
      },
      "body": {
        "message": "Failed to find admin session"
      }
    }
  },
  {
    "admin cookie of another administrator": {
      "status": 500,
      "headers": {
        "content-type": [
          "application/json"
        ]
      },
      "body": {
        "message": "Failed to find admin session"
      }
